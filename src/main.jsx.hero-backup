import React, {useEffect, useRef, useState} from 'react';
import {createRoot} from 'react-dom/client';
import {BrowserRouter, Routes, Route, NavLink, Link, useLocation} from 'react-router-dom';
import {ArrowRight, Phone, Menu, X, Check, ShieldCheck, Clock3, HardHat, Truck, MapPin, ChevronDown, Users, BarChart3} from 'lucide-react';
import {animate, motion, useReducedMotion} from 'framer-motion';
import './styles.css';

const A={home:'https://www.figma.com/api/mcp/asset/cb7b79ef-0fcb-4b13-a85c-f7e26bfd7e5c', labour:'https://www.figma.com/api/mcp/asset/80233759-7b24-40b8-bd59-014a80950ea6', employers:'https://www.figma.com/api/mcp/asset/ddf22ed2-6d19-4b97-8bed-d1ae0057a721', about:'https://www.figma.com/api/mcp/asset/3e1fbf9e-1027-46a9-abcb-93cc7c56a15a'};
const imgs={logo:`${A.home}/2386e.png`, hero:'/assets/hero-visual-hd.png', logistics:`${A.home}/0b2de.png`, labourHero:`${A.labour}/504c1.png`, construction:`${A.labour}/f0f5b.png`, trades:`${A.labour}/a4763.png`, civil:`${A.labour}/7711d.png`, warehouse:`${A.labour}/79c32.png`, employerHero:`${A.employers}/d8d1d.png`, employerLogistics:`${A.employers}/09a78.png`, aboutHero:'/assets/about-hero.jpeg', aboutStory:'/assets/about-story.jpeg'};

const nav=[['Home','/'],['Who We Are','/who-we-are'],['Work Opportunities','/labour-hire'],['Work Areas','/industries'],['Work With Us','/employers'],['Find Work','/find-work'],['Contact Us','/contact']];
const MotionLink=motion.create(Link);
const MotionNavLink=motion.create(NavLink);
function MotionMain({children}){const reduce=useReducedMotion();return <motion.main initial={reduce?false:{opacity:0,y:8}} animate={{opacity:1,y:0}} transition={{duration:reduce?0:.42,ease:[.22,1,.36,1]}}>{children}</motion.main>}
function MotionObserver({root}){const reduce=useReducedMotion();useEffect(()=>{if(reduce||!root.current)return;const sections=[...root.current.querySelectorAll('main section')];const animations=[];sections.forEach(section=>{section.style.opacity='0';section.style.transform='translateY(24px)'});const observer=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(!entry.isIntersecting)return;animations.push(animate(entry.target,{opacity:1,y:0},{duration:.58,ease:[.22,1,.36,1]}));observer.unobserve(entry.target)})},{threshold:.12,rootMargin:'0px 0px -8%'});sections.forEach(section=>observer.observe(section));return()=>{observer.disconnect();animations.forEach(control=>control.stop());sections.forEach(section=>{section.style.opacity='';section.style.transform=''})}},[reduce,root]);return null}
function MotionPage({children}){const reduce=useReducedMotion();const root=useRef(null);return <motion.div ref={root} initial={reduce?false:{opacity:0,y:8}} animate={{opacity:1,y:0}} transition={{duration:reduce?0:.42,ease:[.22,1,.36,1]}}><MotionObserver root={root}/>{children}</motion.div>}
function Header(){const [open,setOpen]=useState(false); return <header className="site-header"><div className="header-inner"><Link className="brand" to="/"><span className="brand-mark">9</span><span><b>9Work Force</b><small>VICTORIA<br/>WORKFORCE</small></span></Link><nav className={open?'open':''}>{nav.map(([n,p])=><MotionNavLink key={p} to={p} className={({isActive})=>isActive?'active':''} onClick={()=>setOpen(false)} whileHover={{y:-1}} transition={{duration:.18}}>{n}</MotionNavLink>)}</nav><div className="header-actions"><a className="phone" href="/contact"><Phone size={14}/>Enquiries</a><MotionLink className="btn orange small" to="/employers" whileHover={{y:-2}} whileTap={{scale:.98}} transition={{duration:.18}}>Apply Now <ArrowRight size={12}/></MotionLink><motion.button className="menu-btn" onClick={()=>setOpen(!open)} whileTap={{scale:.94}} transition={{duration:.15}}>{open?<X/>:<Menu/>}</motion.button></div></div></header>}
function Footer(){return <footer><div className="footer-grid"><div className="footer-about"><div className="footer-title">9Work Force <span>VICTORIA</span></div><p>We recruit and employ reliable workers for our own construction, civil, traffic-management support and warehouse operations across Victoria.</p><div className="chips"><span><MapPin size={13}/> Victoria, Australia</span><span><ShieldCheck size={13}/> Safety Focused</span></div></div><FooterCol title="Work Roles" items={['Construction Labourers','Civil Construction','Traffic Management Workers','Warehouse Workers','General Labourers']}/><FooterCol title="Worker Information" items={['Register Your Details','Worker Screening & Induction','WHS & Safety Procedures','Payroll & Entitlements','Victorian Opportunities']}/><FooterCol title="Victoria Operations" items={['Melbourne & Victoria','Operational Projects','Worker Recruitment','WHS & Site Safety','Employment Enquiries']}/></div><div className="footer-bottom"><span>Workforce Operations &amp; Recruitment Enquiries</span><span>Modern Slavery Statement &nbsp; Privacy Policy &nbsp; WorkCover Terms</span></div><div className="copyright">© 2025 9Work Force Australian Workforce Pty Ltd. All rights reserved.</div></footer>}
function FooterCol({title,items}){return <div><h4>{title}</h4>{items.map((x,i)=><p key={i} className={x.includes('Level')||x.includes('Collins')||x.includes('Eagle')?'muted':''}>{x}</p>)}</div>}
const Btn=({children,to='/employers',light=false})=><MotionLink className={'btn '+(light?'light':'orange')} to={to} whileHover={{y:-2}} whileTap={{scale:.98}} transition={{duration:.18}}>{children}<ArrowRight size={14}/></MotionLink>;
function Badge({children}){return <span className="eyebrow"><i/> {children}</span>}
function Home(){return <><Header/><main><section className="hero home-hero"><div className="hero-copy"><h1 className="hero-heading">Building a Reliable<br/>Workforce<br/><span className="orange-text">for Our Projects.</span></h1><p className="hero-subtext">We recruit reliable and work-ready people for construction, civil construction, traffic-management support, warehousing and other operational roles across Victoria.</p><div className="hero-btn-row"><MotionLink className="btn-find-work" to="/find-work" whileHover={{y:-2}} whileTap={{scale:.98}} transition={{duration:.18}}>Find Work <ArrowRight size={14}/></MotionLink><MotionLink className="btn-register-details" to="/find-work" whileHover={{y:-2}} whileTap={{scale:.98}} transition={{duration:.18}}>Register Your Details <ArrowRight size={14}/></MotionLink></div></div><HeroVisual/><HeroFeatures/></section><Solutions/><Industries/><How/><SplitCTA/><Footer/></main></>}
function HeroVisual(){const reduce=useReducedMotion();return <div className="hero-visual-container"><div className="hero-visual-art"><span className="hero-glow hero-glow-warm"/><span className="hero-glow hero-glow-lilac"/><span className="hero-orange-blob"/><span className="hero-peach-blob"/><span className="hero-dots"/><span className="hero-dots hero-dots-right"/><svg className="hero-orbit hero-orbit-back" viewBox="0 0 700 520" aria-hidden="true"><path d="M 235 270 C 150 285, 60 325, 46 385 C 43 400, 48 418, 62 432"/></svg><img src="/assets/hero-worker-cutout.png" alt="Construction worker" className="hero-worker-image"/><svg className="hero-orbit hero-orbit-front" viewBox="0 0 700 520" aria-hidden="true"><defs><filter id="hero-orbit-node-shadow" x="-50%" y="-50%" width="200%" height="200%"><feDropShadow dx="0" dy="2" stdDeviation="3" floodColor="#0f1d38" floodOpacity="0.18"/></filter></defs><path d="M 62 432 C 78 448, 128 456, 196 452 C 285 448, 385 432, 500 395"/><g transform="translate(196, 452)"><circle cx="0" cy="0" r="17" fill="#ffffff" filter="url(#hero-orbit-node-shadow)"/><circle cx="0" cy="0" r="8" fill="#ff7a1a"/></g></svg><div className="hero-float-card hero-skilled-card"><span className="hero-card-icon"><Users size={20}/></span><span><b>Skilled<br/>Workforce</b><small>Ready for Your Projects</small></span></div><div className="hero-float-card hero-safety-card"><span className="hero-card-icon"><ShieldCheck size={20}/></span><span><b>Safety First</b><small>Compliant &amp; Reliable</small></span></div></div></div>}
function HeroFeatures(){return <div className="hero-features-panel"><div className="feature-col"><div className="feature-icon-badge"><MapPin size={20}/></div><div className="feature-info"><b className="feature-title">VIC</b><span className="feature-sub">VICTORIA BASED</span><p className="feature-desc">Construction, civil and operational projects across Victoria.</p></div></div><div className="feature-sep"/><div className="feature-col"><div className="feature-icon-badge"><ShieldCheck size={20}/></div><div className="feature-info"><b className="feature-title">WHS</b><span className="feature-sub">SAFETY FOCUSED</span><p className="feature-desc">Strict site safety, White Card checks and inductions.</p></div></div><div className="feature-sep"/><div className="feature-col"><div className="feature-icon-badge"><HardHat size={20}/></div><div className="feature-info"><b className="feature-title">SKILLS</b><span className="feature-sub">EXPERIENCE &amp; TICKETS</span><p className="feature-desc">Work-ready people with relevant licences and availability.</p></div></div></div>}
function Metrics(){return <div className="metrics"><div><b>VIC</b><span>Victoria Based</span></div><div><b>WHS</b><span>Safety Focused</span></div><div><b>SKILLS</b><span>Experience &amp; Tickets</span></div></div>}
function Trust(){return <div className="trust">{[['⚡','Active Opportunities'],['◷','Flexible Work'],['✓','Work-Ready People'],['⌖','Victoria-Based Projects'],['♧','Safety & WHS Focused']].map(x=><span key={x[1]}><i>{x[0]}</i>{x[1]}</span>)}</div>}
const solutionData=[
  ['01','Construction Labourers','General construction labour opportunities for suitable workers with relevant experience and site requirements.'],
  ['02','Civil Construction','Opportunities for workers interested in civil construction and infrastructure work.'],
  ['03','Traffic Management Workers','Opportunities for suitable traffic-management support workers, spotters and traffic-management support workers with required qualifications.'],
  ['04','Warehouse Work','Work opportunities involving warehouse operations, loading, unloading, picking, packing and stock handling.']
];
function Solutions(){return <section className="section solutions"><motion.div className="section-heading" initial={{opacity:0,y:-24}} whileInView={{opacity:1,y:0}} viewport={{once:true,amount:.2}} transition={{duration:.55}}><div><Badge>WORK OPPORTUNITIES</Badge><h2>Work Opportunities<br/>Across Victoria.</h2></div><p>We are looking for reliable people for construction, civil construction, traffic-management support, warehousing and other suitable work opportunities.</p></motion.div><div className="solution-grid">{solutionData.map((x,i)=><motion.article className="solution" key={x[0]} initial={{opacity:0,y:38}} whileInView={{opacity:1,y:0}} viewport={{once:true,amount:.18}} transition={{duration:.55,delay:i*.09,ease:[.22,1,.36,1]}} whileHover={{y:-4}}><div className="solution-top"><span>{x[0]}</span><ArrowRight/></div><h3>{x[1]}</h3><p>{x[2]}</p><div className="tags"><small>Work-ready</small><small>Safety focused</small></div><a href="/labour-hire">Explore work roles <ArrowRight size={12}/></a></motion.article>)}</div></section>}
function Industries(){return <section className="section industries"><div className="industry-copy"><Badge>WORK AREAS WHERE WE RECRUIT</Badge><h2>Work Areas Across<br/><em>Our Victorian Projects.</em></h2><p>We recruit dependable workers for our construction, civil, traffic-management support, warehouse and operational projects.</p>{['Construction','Civil Construction','Traffic Management Workers','Warehousing','Logistics','General Operations'].map((x,i)=><div className="industry-row" key={x}><span>{['⌂','▣','⚙','↯','◈','⌁'][i]}</span><b>{x}</b><ArrowRight size={14}/></div>)}</div><div className="industry-image"><img src={imgs.logistics}/><div><Badge>OPERATIONAL ROLES</Badge><h3>Reliable People for Our Project Operations</h3><p>Opportunities for work-ready individuals with the right skills, tickets and availability across Victoria.</p></div></div></section>}
function How(){return <section className="section how"><motion.div initial={{opacity:0,y:-24}} whileInView={{opacity:1,y:0}} viewport={{once:true,amount:.2}} transition={{duration:.55}}><Badge>HOW IT WORKS</Badge><h2>Joining Our Team Is Simple.</h2><p>We look for reliable, work-ready people for our Victorian project operations. Here is how our recruitment process works.</p></motion.div><div className="steps">{[['01','Register Your Details','Tell us about your experience, skills, tickets, availability and preferred type of work.'],['02','Application Review','We review your information against suitable work requirements.'],['03','Start Work','If selected for a suitable opportunity, we will provide the relevant information and next steps.']].map((x,i)=><motion.article key={x[0]} initial={{opacity:0,y:42}} whileInView={{opacity:1,y:0}} viewport={{once:true,amount:.2}} transition={{duration:.55,delay:i*.1,ease:[.22,1,.36,1]}} whileHover={{y:-4}}><b>{x[0]}</b><h3>{x[1]}</h3><p>{x[2]}</p><span>Register for work <ArrowRight size={12}/></span></motion.article>)}</div></section>}
function SplitCTA(){return <section className="split-cta"><div><Badge>WORK WITH US</Badge><h2>Looking for Your Next Opportunity?</h2><p>If you are looking for construction, civil, traffic-management support, warehouse or general labour work in Victoria, register your details with us.</p><Btn to="/find-work">Find Work</Btn></div><div><Badge>REGISTER YOUR DETAILS</Badge><h2>Looking for Work?</h2><p>Tell us about your experience, skills, tickets, availability and preferred work locations. Applications are reviewed based on current business requirements.</p><Btn light to="/find-work">Register for Work</Btn></div></section>}

function PageHero({title,accent,desc,image,children}){const reduce=useReducedMotion();return <section className="page-hero"><div><Badge>9WORK FORCE • VICTORIA OPERATIONS</Badge><h1>{title}<br/><em>{accent}</em></h1><p>{desc}</p>{children}</div>{image&&<motion.img src={image} initial={reduce?false:{opacity:0,scale:1.03}} whileInView={{opacity:1,scale:1}} viewport={{once:true,amount:.2}} transition={{duration:reduce?0:.75,ease:[.22,1,.36,1]}}/>}</section>}
function Labour(){return <><Header/><main><PageHero title="Work Opportunities." accent="Across Victoria." desc="We recruit dependable people for construction, civil, traffic-management support, warehousing and general operational roles across Victoria." image={imgs.labourHero}><div className="hero-buttons"><Btn to="/find-work">Find Work</Btn><Btn light to="/employers">Apply Now</Btn></div><Metrics/></PageHero><Compliance/><section className="section disciplines"><Badge>WORKFORCE ROLES</Badge><h2>Work Opportunities Built<br/><em>Around Our Projects.</em></h2><p>We recruit dependable people with suitable experience, tickets and availability for our operational and construction projects.</p><LabourCards/></section><Workflow/><SplitCTA/><Footer/></main></>}
function Compliance(){return <div className="compliance"><div><ShieldCheck/><b>Operational &amp; Employment Standards</b><span>We operate in accordance with applicable Victorian employment, workplace safety and business requirements.</span></div>{['ABN & BUSINESS REGISTRATION','WORKCOVER & INSURANCE','WHS & SAFETY PROCEDURES','PAYROLL, PAYG & SUPER'].map(x=><span key={x}><Check size={14}/>{x}</span>)}</div>}
const labourCards=[['Construction Labourers','General construction labour opportunities for suitable workers with relevant site experience and White Card.',imgs.construction],['Traffic Management Workers & Spotters','Opportunities for ticketed traffic-management support workers and spotters for site and road traffic-management support.',imgs.trades],['Civil Construction Workers','Opportunities for workers interested in civil construction and infrastructure operations in Victoria.',imgs.civil],['Warehouse Workers','Opportunities involving warehouse operations, loading, unloading, picking, packing and stock handling.',imgs.warehouse],['Trade Assistants','Site-ready support assisting qualified tradespeople, supervisors and operational teams.',imgs.employerHero],['General Labourers','Reliable general labour roles supporting site preparation, material handling and day-to-day work.',imgs.employerLogistics]];
function LabourCards(){return <div className="labour-cards">{labourCards.map((x,i)=><motion.article key={x[0]} initial={{opacity:0,y:42}} whileInView={{opacity:1,y:0}} viewport={{once:true,amount:.16}} transition={{duration:.58,delay:i*.08,ease:[.22,1,.36,1]}} whileHover={{y:-4}}><div><Badge>0{i+1} / WORK ROLE</Badge><h3>{x[0]}</h3><p>{x[1]}</p><ul><li><Check/> Work-ready workers</li><li><Check/> Safety focused</li></ul><a href="/find-work">Apply for this role <ArrowRight size={12}/></a></div><motion.img src={x[2]} initial={{opacity:0,scale:1.04}} whileInView={{opacity:1,scale:1}} viewport={{once:true,amount:.2}} transition={{duration:.7,delay:i*.08}}/></motion.article>)}</div>}
function Workflow(){return <section className="section workflow"><Badge>WORKFORCE OPERATIONS</Badge><h2>How We Manage Workforce Operations at 9Work Force</h2><p>We manage our own recruitment, onboarding, safety, and payroll processes to support our Victorian project operations.</p><div className="workflow-grid">{[['01','Recruitment & Screening','We review worker experience, qualifications, tickets, and availability for suitable roles.'],['02','Onboarding & Verification','White Cards, licences, right-to-work evidence, and safety inductions are checked prior to work.'],['03','Attendance & Site Coordination','Our team manages daily attendance, timesheets, and site-related coordination across our projects.'],['04','Payroll & Safety Compliance','We manage wages, superannuation, WorkCover, and internal WHS requirements.']].map(x=><article key={x[0]}><b>{x[0]}</b><h3>{x[1]}</h3><p>{x[2]}</p></article>)}</div></section>}

function Employers(){return <><Header/><main><section className="employer-hero"><div><Badge>WORK WITH US</Badge><h1>Join Our Team.<br/><em>Work on Victorian Projects.</em></h1><p>We recruit and employ reliable workers for our own construction, civil, traffic-management support, and warehouse projects across Victoria.</p><div className="metrics"><div><b>FLEXIBLE</b><span>work opportunities</span></div><div><b>SAFETY</b><span>focused operations</span></div><div><b>RELIABLE</b><span>onboarding & wages</span></div></div></div><RequestForm/></section><section className="section employer-industries"><Badge>WHY WORK WITH US?</Badge><h2>Workforce opportunities built<br/><em>around reliable people.</em></h2><div className="employer-tiles"><article><img src={imgs.employerHero}/><h3>Practical Work Opportunities</h3><p>Work on active construction, civil, and operational projects across Victoria.</p></article><article><img src={imgs.employerLogistics}/><h3>Compliance &amp; Fair Pay</h3><p>Managed payroll, superannuation, WorkCover insurance, and proper safety standards.</p></article></div></section><section className="section why"><Badge>APPLICATION PROCESS</Badge><h2>From application review<br/>to <em>starting on site.</em></h2><div className="why-grid">{[['Submit Your Details','Tell us your experience, qualifications, tickets, White Card status, and availability.'],['Application Review','We review your application against upcoming project requirements and work needs.'],['Onboarding & Start','If selected for a role, we complete inductions and coordinate your start details.']].map(x=><article key={x[0]}><ShieldCheck/><h3>{x[0]}</h3><p>{x[1]}</p></article>)}</div></section><RequestSection/><Footer/></main></>}
function RequestForm(){return <form className="request-form" onSubmit={e=>e.preventDefault()}><div className="form-head"><b>Join Our Team</b><span>WORKER APPLICATION</span></div><label>What type of work are you interested in?<select><option>Construction Labour</option><option>Civil Construction</option><option>Traffic Management Workers</option><option>Warehouse Work</option><option>Trade Assistant</option></select></label><div className="form-row"><label>Years of experience<input type="number" placeholder="2"/></label><label>Available start date<input type="date"/></label></div><label>Preferred location in Victoria<input placeholder="Melbourne, VIC"/></label><label>Your email address<input type="email" placeholder="you@example.com"/></label><button className="btn orange">SUBMIT APPLICATION <ArrowRight size={14}/></button></form>}
function RequestSection(){return <section className="request-section"><div><Badge>WORKER RECRUITMENT TEAM</Badge><h2>Ready to work on<br/><em>our Victorian projects?</em></h2><p>Register your details, experience and availability today. Our recruitment team reviews applications for suitable opportunities.</p><Btn to="/find-work">Apply for Work</Btn></div><div className="contact-card"><Phone/><b>Worker Enquiries</b><span>Recruitment &amp; Operations Support<br/>Victoria, Australia</span></div></section>}

function WhoWeAre(){return <><Header/><main><section className="about-hero"><div className="about-hero-copy"><Badge>WHO WE ARE • VICTORIAN WORKFORCE OPERATIONS</Badge><h1>Building a Reliable Workforce for <em>Our Projects.</em></h1><p>We are building a reliable workforce for our own construction, operational and project requirements across Victoria, recruiting dependable people with suitable experience, qualifications and availability.</p><div className="hero-buttons"><Btn to="/find-work">Find Work</Btn><Btn light to="/contact">Contact Us</Btn></div><div className="about-trust"><span><ShieldCheck/>Reliable People<small>EXPERIENCE &amp; SKILLS</small></span><span><HardHat/>Safety Matters<small>SITE-READY ONBOARDING</small></span><span><Clock3/>Internal Operations<small>MANAGED PAYROLL &amp; WHS</small></span></div></div><div className="about-photo"><img src={imgs.aboutHero}/><div><b>Operations in Victoria</b><span>Construction labourers, traffic-management support workers and civil workers.</span></div></div></section><section className="about-story section"><img src={imgs.aboutStory}/><div><Badge>WHO WE ARE</Badge><h2>Building Our Team. <em>Focusing on Reliability.</em></h2><p>We are building a reliable workforce for our own construction, operational and project requirements. Our focus is recruiting dependable people with suitable experience, qualifications, tickets and availability.</p><p>We aim to create a reliable workforce while maintaining appropriate employment, payroll, safety and compliance processes in accordance with Victorian requirements.</p><div className="story-points"><span><Check/>Direct worker recruitment</span><span><Check/>Safety &amp; induction compliance</span><span><Check/>Managed payroll &amp; entitlements</span></div></div></section><section className="section approach"><Badge>INTERNAL OPERATIONS</Badge><h2>How We Manage <em>Our Workforce.</em></h2><div className="approach-line">{[['01','Recruitment & Onboarding','Finding and screening suitable workers, verifying tickets, White Cards and right-to-work documentation.'],['02','Safety & WHS Management','Managing worker documentation, site inductions, WHS compliance and safety requirements.'],['03','Payroll & Entitlements','Managing timesheets, wages, superannuation, and applicable employment entitlements internally.']].map(x=><article key={x[0]}><b>{x[0]}</b><h3>{x[1]}</h3><p>{x[2]}</p></article>)}</div></section><section className="section benefit-band"><Badge>OPERATIONAL ROLES</Badge><h2>Internal Workforce <em>Coordination.</em></h2><div className="benefit-grid">{[['Business Manager','Overall business operations and workforce management.'],['Recruitment Officer','Find and screen suitable workers for project requirements.'],['Compliance Officer','Manage worker documentation, licences, tickets, WHS and compliance requirements.'],['Site Coordinator','Manage attendance, worker updates and site-related coordination.']].map(x=><article key={x[0]}><ShieldCheck/><h3>{x[0]}</h3><p>{x[1]}</p></article>)}</div></section><section className="section values"><Badge>SAFETY &amp; VALUES</Badge><h2>Safety Matters. <em>Built Around Good Work.</em></h2><div className="value-grid">{[['Safety','Worker safety is an essential part of our daily operations.'],['Reliability','Dependable attendance and commitment to quality work.'],['Compliance','Strict adherence to Victorian safety and employment standards.'],['Respect','Fair treatment, transparent communication and proper wages.'],['Preparation','Ensuring workers hold required tickets, PPE and inductions.']].map(x=><article key={x[0]}><span>{x[0][0]}</span><h3>{x[0]}</h3><p>{x[1]}</p></article>)}</div></section><section className="about-cta"><div><Badge>LOOKING FOR WORK OPPORTUNITIES?</Badge><h2>Join Our <em>Workforce.</em></h2><p>If you have the skills, experience and tickets for construction, civil or warehouse work in Victoria, we would like to hear from you.</p></div><div className="cta-buttons"><Btn to="/find-work">Apply for Work</Btn><Btn light to="/contact">Get in Touch</Btn></div></section><Footer/></main></>}

const industryItems=[['CONSTRUCTION','Construction labour and site-support opportunities across Victorian building sites.',imgs.construction],['CIVIL CONSTRUCTION','Opportunities in civil construction and infrastructure work throughout Victoria.',imgs.civil],['Traffic Management Workers','Traffic-control, spotting and traffic-management support opportunities for suitably qualified workers.',imgs.trades],['WAREHOUSING','Warehouse and operational work opportunities involving loading, packing and stock handling.',imgs.warehouse],['LOGISTICS','Suitable logistics and operational roles supporting freight and distribution operations.',imgs.logistics],['GENERAL OPERATIONS','Suitable production, maintenance, and general outdoor operational work opportunities.',imgs.employerHero]];
function IndustriesPage(){return <><Header/><main><section className="industry-hero"><div><Badge>WORK AREAS WHERE WE RECRUIT</Badge><h1>Work Areas for <em>Our Victorian Projects.</em></h1><p>We recruit reliable, work-ready people for construction, civil, traffic-management support, warehousing and operational roles across Victoria.</p><div className="hero-buttons"><Btn to="/find-work">Find Work</Btn><Btn light to="/employers">Register Details</Btn></div></div><motion.img src={imgs.employerLogistics} initial={{opacity:0,x:36,scale:1.03}} whileInView={{opacity:1,x:0,scale:1}} viewport={{once:true,amount:.2}} transition={{duration:.75,ease:[.22,1,.36,1]}}/></section><section className="section industry-showcase"><motion.div initial={{opacity:0,y:-24}} whileInView={{opacity:1,y:0}} viewport={{once:true,amount:.2}} transition={{duration:.55}}><Badge>WHERE WE RECRUIT WORKERS</Badge><h2>Work opportunities across<br/><em>our core sectors.</em></h2></motion.div><div className="industry-editorial">{industryItems.map((x,i)=><motion.article key={x[0]} className={i%2?'reverse':''} initial={{opacity:0,x:i%2?34:-34}} whileInView={{opacity:1,x:0}} viewport={{once:true,amount:.16}} transition={{duration:.58,delay:i*.08,ease:[.22,1,.36,1]}} whileHover={{y:-4}}><motion.img src={x[2]} initial={{opacity:0,scale:1.04}} whileInView={{opacity:1,scale:1}} viewport={{once:true,amount:.2}} transition={{duration:.7,delay:i*.08}}/><div><Badge>0{i+1} / WORK AREA</Badge><h3>{x[0]}</h3><p>{x[1]}</p><a href="/find-work">Apply for this work <ArrowRight size={14}/></a></div></motion.article>)}</div></section><section className="section flexible-band"><div><Badge>WORKFORCE REQUIREMENTS</Badge><h2>The Right Skills for the <em>Right Role.</em></h2><p>We recruit people with the right experience, tickets, qualifications and availability for the work we undertake across our operations.</p></div><div className="flexible-list">{['Valid Tickets & Licences','White Card Ready','Safety Inductions','Victorian Locations'].map((x,i)=><motion.span key={x} initial={{opacity:0,y:22}} whileInView={{opacity:1,y:0}} viewport={{once:true,amount:.2}} transition={{duration:.45,delay:i*.08}}><Check/>{x}</motion.span>)}</div></section><section className="simple-cta"><Badge>JOIN OUR TEAM</Badge><h2>Ready to Work in <em>These Industries?</em></h2><Btn to="/find-work">Register for Work</Btn></section><Footer/></main></>}

const workAreas=['Construction Labour','Traffic Management Workers','Civil Construction','Warehouse Work','Trade Assistants','General Labour'];
function FindWork(){return <><Header/><main><section className="worker-hero"><div><Badge>JOBS IN VICTORIA • WORKER RECRUITMENT</Badge><h1>Looking for <em>Your Next Opportunity?</em></h1><p>If you are looking for construction, civil, traffic-management support, warehouse or general labour work in Victoria, register your details with us.</p><div className="hero-buttons"><Btn to="#register">Register for Work</Btn><Btn light to="#opportunities">Explore Opportunities</Btn></div></div><motion.img src={imgs.trades} initial={{opacity:0,x:36,scale:1.03}} whileInView={{opacity:1,x:0,scale:1}} viewport={{once:true,amount:.2}} transition={{duration:.75,ease:[.22,1,.36,1]}}/></section><section id="opportunities" className="section work-opportunities"><motion.div initial={{opacity:0,y:-24}} whileInView={{opacity:1,y:0}} viewport={{once:true,amount:.2}} transition={{duration:.55}}><Badge>WORK OPPORTUNITIES</Badge><h2>Construction &amp; Labour Roles <em>in Victoria.</em></h2></motion.div><div className="work-area-grid">{workAreas.map((x,i)=><motion.a href="#register" key={x} initial={{opacity:0,y:30}} whileInView={{opacity:1,y:0}} viewport={{once:true,amount:.2}} transition={{duration:.5,delay:i*.08}} whileHover={{y:-4}}><span>0{i+1}</span><b>{x}</b><ArrowRight size={16}/></motion.a>)}</div></section><section className="section worker-benefits"><Badge>JOINING OUR WORKFORCE</Badge><h2>Reliable Work. <em>Professional Standards.</em></h2><div className="benefit-grid">{[['Victorian Projects','Opportunities across active construction, civil and operational sites in Victoria.'],['Proper Entitlements','Managed payroll, superannuation, and statutory entitlements under applicable awards.'],['Safety Focused','Clear site inductions, WHS compliance, and supportive site coordination.'],['Simple Registration','Straightforward registration process sharing your skills and availability.'],['Clear Communication','Direct updates and clear instructions before attending any project work.']].map((x,i)=><motion.article key={x[0]} initial={{opacity:0,y:34}} whileInView={{opacity:1,y:0}} viewport={{once:true,amount:.18}} transition={{duration:.52,delay:i*.08}} whileHover={{y:-4}}><HardHat/><h3>{x[0]}</h3><p>{x[1]}</p></motion.article>)}</div></section><section className="section timeline"><Badge>HOW IT WORKS</Badge><h2>Getting Started Is <em>Simple.</em></h2><div className="timeline-row">{[['01','Register Your Details'],['02','Experience & Tickets Review'],['03','Induction & Briefing'],['04','Commence Work']].map((x,i)=><motion.article key={x[0]} initial={{opacity:0,y:28}} whileInView={{opacity:1,y:0}} viewport={{once:true,amount:.2}} transition={{duration:.5,delay:i*.1}}><b>{x[0]}</b><span>{x[1]}</span></motion.article>)}</div></section><section id="register" className="registration"><div><Badge>WORKER REGISTRATION</Badge><h2>Looking for <em>Work?</em></h2><p>Register your details with us and let us know about your experience, skills, tickets, availability and preferred work locations. Applications are reviewed based on experience, qualifications, availability and current business requirements.</p></div><WorkerForm/></section><section className="simple-cta"><Badge>START YOUR APPLICATION</Badge><h2>Ready for Your Next <em>Work Opportunity?</em></h2><Btn to="#register">Register for Work</Btn></section><Footer/></main></>}
function WorkerForm(){return <form className="worker-form" onSubmit={e=>e.preventDefault()}><div className="form-row"><label>Full Name<input required placeholder="Your name"/></label><label>Phone Number<input required placeholder="04xx xxx xxx"/></label></div><div className="form-row"><label>Email Address<input required type="email" placeholder="you@example.com"/></label><label>Location in Victoria<input placeholder="Melbourne, VIC"/></label></div><div className="form-row"><label>Work Type / Category<select><option>Construction Labour</option>{workAreas.slice(1).map(x=><option key={x}>{x}</option>)}</select></label><label>Availability<select><option>Immediately</option><option>Within 2 weeks</option><option>Just exploring</option></select></label></div><label>Experience &amp; Tickets<textarea rows="3" placeholder="Tell us about your experience, White Card, traffic-management support tickets or licences"/></label><label>Upload Resume / CV<input type="file"/></label><label>Message / Additional Information<textarea rows="3" placeholder="Right-to-work status, preferred locations, and any extra details"/></label><button className="btn orange">REGISTER FOR WORK <ArrowRight size={14}/></button></form>}

function Contact(){return <><Header/><main><section className="contact-hero"><Badge>9WORK FORCE • VICTORIA OPERATIONS</Badge><h1>Interested in <em>Working With Us?</em></h1><p>Send us your details, experience, qualifications and availability and our team can review your application for suitable opportunities.</p></section><section className="contact-main"><div className="contact-info"><Badge>WORKER &amp; GENERAL ENQUIRIES</Badge><h2>Let’s Start a <em>Conversation.</em></h2><p>We are always interested in connecting with reliable, work-ready people for our construction, civil, traffic-management support and warehouse operations in Victoria.</p><div className="contact-details"><span><Phone/><b>Worker Enquiries</b><small>Submit an enquiry or registration online</small></span><span><MapPin/><b>Victoria Operations</b><small>Melbourne and Regional Victoria</small></span><span><Clock3/><b>Operating Hours</b><small>Monday–Friday, 8:00am–5:00pm AEST</small></span></div></div><ContactForm/></section><section className="quick-path"><div><Badge>JOIN OUR TEAM</Badge><h2>Looking for Work?</h2><p>Explore current work areas and submit your application for upcoming projects.</p><Btn to="/find-work">Apply Now</Btn></div><div><Badge>REGISTER YOUR DETAILS</Badge><h2>Register for Work</h2><p>Register your details with our team to be considered for suitable work opportunities.</p><Btn light to="/find-work">Register for Work</Btn></div></section><Footer/></main></>}
function ContactForm(){return <form className="contact-form" onSubmit={e=>e.preventDefault()}><h3>Worker &amp; Employment Enquiry</h3><div className="form-row"><label>Full Name<input required placeholder="Your name"/></label><label>Preferred Role<input placeholder="e.g. Construction Labourer"/></label></div><div className="form-row"><label>Phone<input required placeholder="04xx xxx xxx"/></label><label>Email<input required type="email" placeholder="you@example.com"/></label></div><div className="form-row"><label>Work Category<select><option>Construction Labour</option><option>Civil Construction</option><option>Traffic Management Workers</option><option>Warehouse Work</option><option>General Labour</option></select></label><label>Licences &amp; Tickets<input placeholder="e.g. White Card, Traffic Management Workers"/></label></div><div className="form-row"><label>Location in Victoria<input placeholder="Melbourne, VIC"/></label><label>Available Start Date<input type="date"/></label></div><label>Experience &amp; Availability<textarea rows="5" placeholder="Tell us about your experience, qualifications, and availability"/></label><button className="btn orange">SUBMIT ENQUIRY <ArrowRight size={14}/></button></form>}
function App(){return <Routes><Route path="/" element={<MotionPage><Home/></MotionPage>}/><Route path="/labour-hire" element={<MotionPage><Labour/></MotionPage>}/><Route path="/employers" element={<MotionPage><Employers/></MotionPage>}/><Route path="/who-we-are" element={<MotionPage><WhoWeAre/></MotionPage>}/><Route path="/about" element={<MotionPage><WhoWeAre/></MotionPage>}/><Route path="/industries" element={<MotionPage><IndustriesPage/></MotionPage>}/><Route path="/find-work" element={<MotionPage><FindWork/></MotionPage>}/><Route path="/contact" element={<MotionPage><Contact/></MotionPage>}/></Routes>}
createRoot(document.getElementById('root')).render(<BrowserRouter><App/></BrowserRouter>);


