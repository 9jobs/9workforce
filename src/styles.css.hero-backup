@import url('https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');
:root{--navy:#0f1d38;--blue:#163265;--brand:#30497d;--orange:#ff8e38;--paper:#f8f9ff;--pale:#eff4ff;--ink:#44464f;--muted:#747780;--line:#dfe7f4}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:14px Inter,Arial,sans-serif}a{text-decoration:none;color:inherit}button,input,select{font:inherit}h1,h2,h3,h4,p{margin:0}h1,h2,h3,h4{font-family:'Plus Jakarta Sans',sans-serif;color:var(--navy)}h1{font-size:56px;line-height:1.08;letter-spacing:-1.8px}h2{font-size:40px;line-height:1.2;letter-spacing:-1px}h3{font-size:20px;line-height:1.35}em{font-style:normal;color:var(--orange)}.site-header{position:absolute;z-index:10;top:0;left:0;width:100%;padding:8px 24px}.header-inner{height:80px;max-width:1440px;margin:auto;background:rgba(255,255,255,.86);backdrop-filter:blur(12px);border-radius:12px;box-shadow:0 4px 20px rgba(15,29,56,.06);display:flex;align-items:center;padding:0 24px;gap:24px}.brand{display:flex;align-items:center;gap:16px;flex-shrink:0}.brand img{width:140px;height:32px;object-fit:contain}.brand span{display:flex;flex-direction:column;color:var(--navy);font:600 20px 'Plus Jakarta Sans';line-height:20px;letter-spacing:-.5px}.brand small{font:700 11px Inter;color:var(--muted);letter-spacing:.55px;line-height:16px;margin-top:2px}.site-header nav{display:flex;align-items:center;gap:4px;margin-left:0}.site-header nav a{padding:8px 16px;border-radius:8px;font-weight:600;font-size:14px;line-height:20px;text-align:center}.site-header nav a.active{background:var(--brand);color:#a1b9f5;font-size:16px}.header-actions{margin-left:auto;display:flex;gap:8px;align-items:center}.phone{background:#e5eeff;border-radius:8px;min-height:44px;padding:10px 18px;display:flex;gap:8px;align-items:center;font-weight:600;color:var(--navy);line-height:20px}.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:14px 24px;border-radius:8px;border:0;font-weight:600;letter-spacing:.14px;cursor:pointer}.btn.orange{background:var(--orange);color:#fff;box-shadow:0 8px 10px rgba(242,132,47,.24)}.btn.light{background:#e5eeff;color:#163265}.btn.small{min-height:44px;padding:10px 20px;line-height:20px}.menu-btn{display:none;border:0;background:var(--blue);color:white;border-radius:50%;width:34px;height:34px}.hero,.page-hero{max-width:1280px;margin:0 auto;padding:176px 48px 96px;display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:center}.hero-copy{max-width:590px}.eyebrow{display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border-radius:999px;background:#dce9ff;color:#44464f;font-size:11px;font-weight:700;letter-spacing:.55px;text-transform:uppercase;line-height:16px}.eyebrow i,.live i{width:8px;height:8px;background:var(--orange);border-radius:50%;display:inline-block}.hero-copy>p,.page-hero p{font-size:18px;line-height:28px;max-width:576px;margin:24px 0;color:var(--ink)}.hero-buttons{display:flex;gap:16px;margin-bottom:40px}.hero-image{height:522px;border-radius:24px;overflow:hidden;position:relative;box-shadow:0 24px 60px -15px rgba(15,29,56,.18)}.hero-image:after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,rgba(15,29,56,.6),transparent 55%)}.hero-image>img{width:100%;height:100%;object-fit:cover}.live,.stat{position:absolute;z-index:1;display:flex;align-items:center;gap:12px;padding:14px;background:rgba(255,255,255,.95);border-radius:12px;box-shadow:0 12px 30px rgba(15,29,56,.12)}.live{top:24px;left:24px}.live i{background:#059669;box-shadow:0 0 0 5px rgba(5,150,105,.2)}.live span{font-size:11px;font-weight:700;color:var(--muted);letter-spacing:.55px}.live b{display:block;color:var(--navy);font-size:14px;letter-spacing:0;margin-top:3px}.stat{right:24px;bottom:24px;background:rgba(24,40,72,.9);color:white}.stat svg{padding:9px;background:rgba(255,142,56,.2);border-radius:8px;width:40px;height:40px;color:var(--orange)}.stat strong{font:700 20px 'Plus Jakarta Sans'}.stat small{display:block;font:600 12px Inter;color:#d3e4fe;line-height:15px;margin-top:4px}.metrics{display:flex;gap:24px;background:rgba(239,244,255,.5);padding:16px;border-radius:12px;max-width:512px}.metrics div{flex:1}.metrics b{font:800 26px 'Plus Jakarta Sans';color:var(--blue);display:block}.metrics span{font-size:11px;color:var(--muted);display:block;margin-top:3px}.trust{background:#eff4ff;display:flex;justify-content:center;gap:16px;padding:24px;box-shadow:0 1px 1px rgba(0,0,0,.05)}.trust span{width:234px;display:flex;justify-content:center;align-items:center;gap:8px;font-weight:600;color:#0b1c30}.trust i{font-style:normal;color:var(--brand)}.section{max-width:1280px;margin:auto;padding:88px 48px}.section-heading{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:40px}.section-heading p{max-width:420px;line-height:24px}.solutions h2{margin-top:8px}.solution-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}.solution{background:white;border-radius:12px;padding:24px;border-top:6px solid var(--brand);min-height:296px;box-shadow:0 1px 2px rgba(15,29,56,.04)}.solution:nth-child(2n){border-color:var(--orange)}.solution-top{display:flex;justify-content:space-between;color:var(--blue);font-weight:700}.solution-top svg{background:#e5eeff;padding:10px;width:40px;height:40px;border-radius:8px}.solution h3{margin:24px 0 12px}.solution p{line-height:24px;min-height:72px}.tags{display:flex;gap:8px;margin:18px 0}.tags small{background:#eff4ff;padding:4px 10px;border-radius:4px;color:var(--blue)}.solution a,.labour-cards a{color:var(--blue);font-weight:600;display:inline-flex;gap:6px;align-items:center}.industries{display:grid;grid-template-columns:1fr 1fr;gap:24px;background:#eff4ff;max-width:none;padding-left:max(48px,calc((100% - 1184px)/2));padding-right:max(48px,calc((100% - 1184px)/2))}.industry-copy p{line-height:24px;margin:20px 0;max-width:480px}.industry-row{background:white;border-bottom:1px solid var(--line);padding:15px 16px;display:flex;align-items:center;gap:12px}.industry-row span{color:var(--blue);font-size:20px}.industry-row svg{margin-left:auto}.industry-image{min-height:470px;border-radius:16px;overflow:hidden;position:relative;color:white}.industry-image:after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,rgba(15,29,56,.85),transparent 70%)}.industry-image img{width:100%;height:100%;position:absolute;object-fit:cover}.industry-image>div{position:absolute;z-index:1;bottom:28px;left:28px;right:28px}.industry-image h3{color:white;margin:10px 0}.how{text-align:center}.how>p{max-width:500px;margin:12px auto 40px;line-height:24px}.steps,.workflow-grid,.why-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;text-align:left}.steps article,.workflow-grid article,.why-grid article{background:white;border-radius:12px;padding:24px;box-shadow:0 1px 2px rgba(15,29,56,.05)}.steps article>b,.workflow-grid article>b{display:block;background:#163265;color:white;border-radius:8px;width:32px;height:32px;text-align:center;padding-top:7px;margin-bottom:24px}.steps article:nth-child(2) article>b{background:var(--orange)}.steps h3{font-size:16px}.steps p,.workflow-grid p,.why-grid p{line-height:22px;margin:10px 0 20px}.steps span{font-size:12px;color:var(--blue)}.split-cta,.request-section{max-width:1184px;margin:0 auto 88px;border-radius:12px;display:grid;grid-template-columns:1fr 1fr;overflow:hidden;background:#163265;color:white;box-shadow:0 8px 20px rgba(15,29,56,.12)}.split-cta>div{padding:40px}.split-cta>div+div{background:#0f1d38}.split-cta h2,.request-section h2{color:white;margin:10px 0}.split-cta p,.request-section p{line-height:22px;margin:12px 0 24px;color:#d3e4fe}.split-cta .eyebrow,.request-section .eyebrow{background:rgba(255,255,255,.1);color:#d3e4fe}footer{background:#0f1d38;color:#d3e4fe;padding:72px max(48px,calc((100% - 1184px)/2)) 24px;border-top:4px solid var(--orange)}.footer-grid{display:grid;grid-template-columns:2fr repeat(3,1fr);gap:32px;padding-bottom:48px}.footer-title{font:700 22px 'Plus Jakarta Sans';color:white}.footer-title span{font:11px Inter;color:var(--orange);margin-left:8px}.footer-about>p{line-height:24px;max-width:360px;margin:20px 0}.footer-grid h4{color:white;margin-bottom:16px}.footer-grid p{line-height:22px;margin:8px 0}.muted{color:#a9b9d8}.chips{display:flex;flex-wrap:wrap;gap:8px}.chips span,.footer-bottom span:first-child{background:#182848;padding:7px 10px;border-radius:6px;color:#d97706;font-size:12px;display:inline-flex;gap:6px;align-items:center}.footer-bottom{border-top:1px solid rgba(226,232,240,.1);padding-top:18px;display:flex;justify-content:space-between;font-size:12px}.copyright{text-align:center;padding-top:24px;color:var(--muted);font-size:12px}.page-hero{background:#163265;color:white;max-width:none;padding-left:max(48px,calc((100% - 1184px)/2));padding-right:max(48px,calc((100% - 1184px)/2));min-height:650px}.page-hero h1{color:white;margin-top:12px}.page-hero p{color:#d3e4fe}.page-hero>img{width:100%;height:430px;object-fit:cover;border-radius:16px}.compliance{display:flex;align-items:center;gap:18px;padding:16px max(48px,calc((100% - 1184px)/2));background:#e5eeff;flex-wrap:wrap}.compliance>div{display:grid;grid-template-columns:42px 1fr;flex:1;min-width:310px}.compliance svg{grid-row:span 2;background:var(--blue);color:white;padding:10px;border-radius:10px;width:42px;height:42px}.compliance b{font:600 18px 'Plus Jakarta Sans';color:var(--navy)}.compliance span{background:white;padding:10px;border-radius:8px;font-size:11px;font-weight:700;color:var(--navy);display:flex;gap:6px;align-items:center}.disciplines{text-align:center}.disciplines>p{line-height:24px;margin:12px auto 40px}.labour-cards{display:grid;gap:24px;text-align:left}.labour-cards article{display:grid;grid-template-columns:1fr 1fr;background:white;border-radius:12px;overflow:hidden;min-height:360px}.labour-cards article:nth-child(even){direction:rtl}.labour-cards article:nth-child(even)>div{direction:ltr}.labour-cards article>div{padding:40px}.labour-cards img{width:100%;height:100%;object-fit:cover}.labour-cards h3{font-size:28px;margin:16px 0}.labour-cards p{line-height:24px}.labour-cards ul{list-style:none;padding:0;line-height:28px;margin:20px 0}.labour-cards li{display:flex;gap:8px;align-items:center;color:var(--blue)}.labour-cards li svg{width:14px}.workflow{background:#eff4ff;max-width:none;padding-left:max(48px,calc((100% - 1184px)/2));padding-right:max(48px,calc((100% - 1184px)/2))}.workflow>p{line-height:24px;margin:12px 0 40px}.workflow-grid{grid-template-columns:repeat(4,1fr)}.employer-hero{background:#0f1d38;color:white;padding:176px max(48px,calc((100% - 1184px)/2)) 72px;display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:center}.employer-hero h1{color:white;margin:12px 0}.employer-hero p{line-height:24px;color:#d3e4fe;max-width:500px;margin-bottom:32px}.request-form{background:white;color:var(--ink);border-radius:12px;padding:24px}.form-head{display:flex;justify-content:space-between;margin-bottom:18px;color:var(--navy);font-family:'Plus Jakarta Sans'}.form-head span{font:700 10px Inter;color:var(--orange)}.request-form label{display:block;font-size:12px;font-weight:600;margin:14px 0}.request-form input,.request-form select{display:block;width:100%;padding:12px;border:1px solid var(--line);border-radius:6px;margin-top:6px;background:white}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}.request-form .btn{width:100%;margin-top:12px}.employer-industries h2{margin:12px 0 32px}.employer-tiles{display:grid;grid-template-columns:1fr 1fr;gap:16px}.employer-tiles article{position:relative;min-height:320px;border-radius:12px;overflow:hidden;color:white;padding:24px;display:flex;flex-direction:column;justify-content:flex-end}.employer-tiles img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}.employer-tiles article:after{content:'';position:absolute;inset:0;background:linear-gradient(transparent,rgba(15,29,56,.9))}.employer-tiles h3,.employer-tiles p{position:relative;z-index:1;color:white}.employer-tiles p{margin-top:6px}.why{text-align:center;background:white;max-width:none}.why-grid{max-width:1184px;margin:32px auto 0;text-align:left}.why-grid svg{color:var(--orange);margin-bottom:16px}.why-grid h3{font-size:17px}.request-section{padding:40px;align-items:center}.contact-card{justify-self:end;background:#e5eeff;color:var(--navy);padding:24px;border-radius:12px;display:grid;grid-template-columns:40px 1fr;gap:8px 12px;min-width:260px}.contact-card svg{grid-row:span 2}.contact-card span{font-size:12px;color:var(--muted)}.placeholder{min-height:760px;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;max-width:1184px;margin:auto;padding:160px 48px}.placeholder h1{margin:16px 0}.placeholder p{max-width:500px;line-height:24px;margin-bottom:24px}
@media(max-width:1100px){.brand span{display:none}.site-header nav a{padding:8px 9px}.header-inner{gap:10px}.phone{display:none}.hero,.page-hero{padding-left:32px;padding-right:32px}.industries{padding-left:32px;padding-right:32px}.section{padding-left:32px;padding-right:32px}.footer-grid{grid-template-columns:1.5fr 1fr 1fr}.footer-grid>div:last-child{grid-column:span 2}}
@media(max-width:780px){h1{font-size:42px}h2{font-size:32px}.site-header{padding:8px 12px}.header-inner{padding:0 14px}.site-header nav{display:none;position:absolute;top:76px;left:12px;right:12px;background:white;padding:12px;border-radius:12px;box-shadow:0 10px 30px rgba(15,29,56,.15);flex-direction:column;align-items:stretch}.site-header nav.open{display:flex}.site-header nav a{text-align:left}.header-actions{margin-left:auto}.menu-btn{display:grid;place-items:center}.header-actions .btn{display:none}.brand img{width:120px}.hero,.page-hero,.employer-hero{grid-template-columns:1fr;padding:132px 24px 56px;min-height:auto}.hero-copy>p,.page-hero p{font-size:16px;line-height:24px}.hero-image{height:350px}.trust{overflow:auto;justify-content:flex-start;gap:8px;padding:16px 12px}.trust span{min-width:210px}.section{padding:56px 24px}.section-heading{display:block}.section-heading p{margin-top:16px}.solution-grid,.industries,.steps,.workflow-grid,.employer-tiles,.why-grid,.request-section{grid-template-columns:1fr}.industry-image{min-height:340px}.split-cta{grid-template-columns:1fr;margin:0 24px 56px}.split-cta>div{padding:32px 24px}.footer-grid{grid-template-columns:1fr 1fr;padding-bottom:32px}.footer-grid>div:last-child{grid-column:auto}.footer-bottom{display:block;line-height:24px}.footer-bottom span{display:block;margin-top:12px}.page-hero>img{height:320px}.compliance{padding:16px 24px}.compliance>div{min-width:100%}.compliance span{flex:1}.labour-cards article,.labour-cards article:nth-child(even){grid-template-columns:1fr;direction:ltr}.labour-cards img{height:230px;grid-row:1}.labour-cards article>div{padding:28px}.employer-hero{padding-top:132px}.request-form{padding:18px}.placeholder{padding:140px 24px 80px;min-height:650px}.about-hero,.industry-hero,.worker-hero{grid-template-columns:1fr;padding:132px 24px 56px;gap:28px}.about-hero-copy>p,.industry-hero p,.worker-hero p{font-size:16px;line-height:24px}.about-photo img,.industry-hero>img,.worker-hero>img{height:300px}.about-trust{grid-template-columns:1fr}.about-story{grid-template-columns:1fr;gap:28px}.about-story>img{height:300px}.approach-line,.benefit-grid,.value-grid{grid-template-columns:1fr}.about-cta,.simple-cta{margin:0 24px 56px;padding:28px 24px;display:block}.cta-buttons{margin-top:24px}.industry-editorial article,.industry-editorial article.reverse{grid-template-columns:1fr;direction:ltr}.industry-editorial article>div{padding:28px}.industry-editorial img{min-height:220px;height:220px}.flexible-band{grid-template-columns:1fr;gap:28px}.flexible-list{grid-template-columns:1fr}.work-area-grid{grid-template-columns:1fr}.worker-benefits .benefit-grid{grid-template-columns:1fr}.timeline-row{grid-template-columns:1fr;gap:20px;text-align:left;margin-left:20px}.timeline-row:before{top:20px;bottom:20px;left:20px;right:auto;border-top:0;border-left:2px dashed #b8cbed}.timeline-row article{flex-direction:row;align-items:center}.registration{grid-template-columns:1fr;margin:0 24px 56px;padding:28px 20px;gap:24px}.contact-hero{padding:146px 24px 64px}.contact-hero h1{font-size:52px}.contact-main{grid-template-columns:1fr;padding:56px 24px;gap:32px}.quick-path{grid-template-columns:1fr;margin:0 24px 56px}.quick-path>div{padding:28px 24px}.form-row{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
.brand-mark{width:30px;height:30px;display:grid;place-items:center;background:linear-gradient(135deg,var(--brand) 0 55%,var(--orange) 55%);color:white;border-radius:6px;font:800 22px 'Plus Jakarta Sans';transform:skew(-10deg)}
.about-hero,.industry-hero,.worker-hero{max-width:1280px;margin:auto;padding:120px 48px 72px;display:grid;grid-template-columns:7fr 5fr;gap:48px;align-items:center}.about-hero h1,.industry-hero h1,.worker-hero h1{margin:16px 0}.about-hero-copy>p,.industry-hero p,.worker-hero p{font-size:18px;line-height:29px;max-width:672px;margin-bottom:16px}.about-trust{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:24px}.about-trust span{background:#fff;border-radius:12px;padding:14px 12px;box-shadow:0 1px 2px rgba(15,29,56,.05);font-weight:700;color:var(--navy);display:grid;grid-template-columns:36px 1fr;align-items:center;gap:8px;font-size:12px}.about-trust svg{width:36px;height:36px;padding:9px;border-radius:8px;background:#e5eeff;color:var(--blue)}.about-trust small{grid-column:2;color:var(--muted);font-size:9px;letter-spacing:.7px}.about-photo,.industry-hero>img,.worker-hero>img{width:100%;height:460px;object-fit:cover;border-radius:16px;box-shadow:0 20px 25px -5px rgba(0,0,0,.1)}.about-photo{position:relative;background:#fff;overflow:hidden}.about-photo img{width:100%;height:100%;object-fit:cover}.about-photo div{position:absolute;bottom:16px;left:16px;right:16px;background:rgba(15,29,56,.95);color:white;border-radius:12px;padding:16px;display:flex;flex-direction:column;gap:4px}.about-photo span{color:#d3e4fe}.about-story{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}.about-story>img{width:100%;height:520px;object-fit:cover;border-radius:16px}.about-story h2,.approach h2,.industry-showcase>h2,.work-opportunities h2,.worker-benefits h2,.timeline h2{margin:12px 0 20px}.about-story p,.contact-info>p{line-height:24px;margin:12px 0}.story-points{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}.story-points span{display:flex;gap:6px;align-items:center;color:var(--blue);font-weight:600}.story-points svg{width:15px}.approach,.benefit-band,.worker-benefits{max-width:none;background:#eff4ff;text-align:center}.approach-line,.benefit-grid,.value-grid{max-width:1184px;margin:32px auto 0;display:grid;grid-template-columns:repeat(3,1fr);gap:16px;text-align:left}.approach-line article,.benefit-grid article,.value-grid article{background:#fff;border-radius:12px;padding:24px;box-shadow:0 1px 2px rgba(15,29,56,.05)}.approach-line b{display:block;color:var(--blue);font:800 32px 'Plus Jakarta Sans';margin-bottom:22px}.approach-line h3,.benefit-grid h3,.value-grid h3{font-size:17px}.approach-line p,.benefit-grid p,.value-grid p{line-height:22px;margin-top:10px}.benefit-grid{grid-template-columns:repeat(4,1fr)}.benefit-grid svg{color:var(--orange);margin-bottom:12px}.values{text-align:center}.value-grid{grid-template-columns:repeat(4,1fr)}.value-grid article>span{display:grid;place-items:center;width:32px;height:32px;border-radius:8px;background:#e5eeff;color:var(--blue);font-weight:800;margin-bottom:16px}.about-cta,.simple-cta{max-width:1184px;margin:0 auto 88px;border-radius:12px;background:linear-gradient(110deg,#163265,#0f1d38 65%,#2b2831);color:white;padding:40px;display:flex;align-items:center;justify-content:space-between;gap:24px;box-shadow:0 8px 20px rgba(15,29,56,.12)}.about-cta h2,.simple-cta h2{color:#fff;margin:10px 0}.about-cta p{color:#d3e4fe}.about-cta .eyebrow,.simple-cta .eyebrow{background:rgba(255,255,255,.1);color:#d3e4fe}.cta-buttons{display:flex;gap:12px;flex-wrap:wrap}.industry-hero,.worker-hero{max-width:none;background:#163265;color:white;padding-left:max(48px,calc((100% - 1184px)/2));padding-right:max(48px,calc((100% - 1184px)/2))}.industry-hero h1,.worker-hero h1{color:white}.industry-hero p,.worker-hero p{color:#d3e4fe}.industry-hero>img,.worker-hero>img{height:410px}.industry-showcase>h2{margin-bottom:36px}.industry-editorial{display:grid;gap:24px}.industry-editorial article{display:grid;grid-template-columns:1fr 1fr;min-height:300px;background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 1px 2px rgba(15,29,56,.05)}.industry-editorial article.reverse{direction:rtl}.industry-editorial article.reverse>div{direction:ltr}.industry-editorial img{width:100%;height:100%;min-height:300px;object-fit:cover}.industry-editorial article>div{padding:40px;display:flex;flex-direction:column;justify-content:center}.industry-editorial h3{font-size:28px;margin:14px 0}.industry-editorial p{line-height:24px;margin-bottom:22px}.industry-editorial a{color:var(--blue);font-weight:600;display:inline-flex;align-items:center;gap:8px}.flexible-band{max-width:none;background:#eff4ff;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}.flexible-band h2{margin:12px 0}.flexible-band p{line-height:24px;max-width:520px}.flexible-list{display:grid;grid-template-columns:1fr 1fr;gap:12px}.flexible-list span{background:#fff;padding:16px;border-radius:10px;color:var(--blue);font-weight:600;display:flex;gap:8px;align-items:center}.flexible-list svg{width:16px}.simple-cta{flex-direction:column;text-align:center;margin:64px auto 88px}.simple-cta h2{margin:10px 0 22px}.work-area-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.work-area-grid a{background:#fff;border-radius:12px;padding:24px;display:grid;grid-template-columns:40px 1fr 20px;align-items:center;gap:12px;box-shadow:0 1px 2px rgba(15,29,56,.05);transition:transform .2s,box-shadow .2s}.work-area-grid a:hover{transform:translateY(-3px);box-shadow:0 12px 25px rgba(15,29,56,.1)}.work-area-grid span{color:var(--orange);font:800 22px 'Plus Jakarta Sans'}.work-area-grid b{font:600 18px 'Plus Jakarta Sans';color:var(--navy)}.worker-benefits{background:#fff}.worker-benefits .benefit-grid{grid-template-columns:repeat(5,1fr);text-align:left}.timeline{text-align:center}.timeline-row{max-width:1000px;margin:40px auto 0;display:grid;grid-template-columns:repeat(4,1fr);position:relative}.timeline-row:before{content:'';position:absolute;top:20px;left:12%;right:12%;border-top:2px dashed #b8cbed}.timeline-row article{position:relative;display:flex;flex-direction:column;align-items:center;gap:12px}.timeline-row b{z-index:1;background:var(--orange);color:#fff;width:40px;height:40px;border-radius:50%;display:grid;place-items:center}.timeline-row span{font-weight:700;color:var(--navy)}.registration{max-width:1184px;margin:0 auto 88px;padding:48px;border-radius:16px;background:#e5eeff;display:grid;grid-template-columns:1fr 1.2fr;gap:48px}.registration h2{margin:12px 0}.registration p{line-height:24px}.worker-form,.contact-form{background:#fff;border-radius:12px;padding:24px}.worker-form label,.contact-form label{display:block;font-size:12px;font-weight:600;margin:12px 0}.worker-form input,.worker-form select,.worker-form textarea,.contact-form input,.contact-form select,.contact-form textarea{display:block;width:100%;margin-top:6px;border:1px solid var(--line);border-radius:6px;padding:11px;background:#fff;resize:vertical}.worker-form .btn,.contact-form .btn{width:100%;margin-top:8px}.contact-hero{padding:168px 24px 76px;text-align:center;background:linear-gradient(120deg,#eff4ff,#f8f9ff 55%,#fff7ed)}.contact-hero h1{font-size:64px;margin:12px 0}.contact-hero p{font-size:18px;line-height:28px;max-width:600px;margin:auto}.contact-main{max-width:1184px;margin:0 auto;padding:88px 0;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start}.contact-info h2{margin:12px 0}.contact-details{display:grid;gap:22px;margin-top:36px}.contact-details span{display:grid;grid-template-columns:40px 1fr;gap:4px 12px}.contact-details svg{grid-row:span 2;color:var(--orange);background:#fff7ed;padding:10px;width:40px;height:40px;border-radius:8px}.contact-details b{color:var(--navy)}.contact-details small{color:var(--muted)}.contact-form h3{font-size:22px;margin-bottom:18px}.quick-path{max-width:1184px;margin:0 auto 88px;display:grid;grid-template-columns:1fr 1fr;gap:16px}.quick-path>div{padding:36px;border-radius:12px;background:#163265;color:#fff}.quick-path>div+div{background:#0f1d38}.quick-path h2{color:#fff;margin:10px 0}.quick-path p{color:#d3e4fe;margin-bottom:22px}
@media(max-width:780px){.brand-mark{width:27px;height:27px;font-size:19px}.about-hero,.industry-hero,.worker-hero{grid-template-columns:1fr;padding:132px 24px 56px;gap:28px}.about-hero-copy>p,.industry-hero p,.worker-hero p{font-size:16px;line-height:24px}.about-photo,.industry-hero>img,.worker-hero>img{height:300px}.about-trust,.approach-line,.benefit-grid,.value-grid{grid-template-columns:1fr}.about-story{grid-template-columns:1fr;gap:28px}.about-story>img{height:300px}.about-cta,.simple-cta{margin:0 24px 56px;padding:28px 24px;display:block}.cta-buttons{margin-top:24px}.industry-editorial article,.industry-editorial article.reverse{grid-template-columns:1fr;direction:ltr}.industry-editorial article>div{padding:28px}.industry-editorial img{min-height:220px;height:220px}.flexible-band{grid-template-columns:1fr;gap:28px}.flexible-list,.work-area-grid{grid-template-columns:1fr}.worker-benefits .benefit-grid{grid-template-columns:1fr}.timeline-row{grid-template-columns:1fr;gap:20px;text-align:left;margin-left:20px}.timeline-row:before{top:20px;bottom:20px;left:20px;right:auto;border-top:0;border-left:2px dashed #b8cbed}.timeline-row article{flex-direction:row;align-items:center}.registration{grid-template-columns:1fr;margin:0 24px 56px;padding:28px 20px;gap:24px}.contact-hero{padding:146px 24px 64px}.contact-hero h1{font-size:52px}.contact-main{grid-template-columns:1fr;padding:56px 24px;gap:32px}.quick-path{grid-template-columns:1fr;margin:0 24px 56px}.quick-path>div{padding:28px 24px}.form-row{grid-template-columns:1fr}}

/* Motion layer: transform and opacity only, so the approved layout remains unchanged. */
@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
}

/* Responsive safety layer: preserves the approved desktop composition and only
   reorganises existing elements at narrower widths. */
@media (max-width:1100px) and (min-width:781px){
  .header-inner{padding:0 16px;gap:8px}
  .site-header nav{gap:0;min-width:0}
  .site-header nav a{padding:8px 7px;font-size:12px}
  .header-actions .btn.small{padding-left:14px;padding-right:14px}
  .about-hero,.industry-hero,.worker-hero{padding-left:32px;padding-right:32px;gap:28px}
  .about-hero-copy,.industry-hero>div,.worker-hero>div,.section-heading>div{min-width:0}
  .about-photo,.industry-hero>img,.worker-hero>img{height:390px}
  .about-trust{gap:8px}
  .about-trust span{grid-template-columns:30px 1fr;font-size:11px;padding:12px 8px}
  .about-trust svg{width:30px;height:30px;padding:7px}
  .section{padding-left:32px;padding-right:32px}
  .contact-main{padding-left:32px;padding-right:32px;gap:32px}
  .quick-path{margin-left:32px;margin-right:32px}
  .registration{margin-left:32px;margin-right:32px;padding:40px 32px;gap:32px}
}

@media (max-width:860px) and (min-width:781px){
  .site-header nav a{padding-left:5px;padding-right:5px;font-size:11px}
  .header-actions .btn.small{padding-left:10px;padding-right:10px;font-size:11px}
  .brand{gap:10px}
  .about-hero,.industry-hero,.worker-hero{gap:20px}
  .about-photo,.industry-hero>img,.worker-hero>img{height:340px}
  .workflow-grid{grid-template-columns:repeat(2,1fr)}
  .footer-grid{gap:20px}
}

@media (max-width:780px){
  html,body,#root{max-width:100%;}
  .site-header,.header-inner,.hero,.page-hero,.about-hero,.industry-hero,.worker-hero,
  .section,.contact-main,.registration,.quick-path,.split-cta,.request-section{min-width:0}
  .hero-copy,.page-hero>div,.about-hero-copy,.about-story>div,.industry-editorial article>div,
  .contact-info,.contact-form,.worker-form,.request-form,.footer-grid>div{min-width:0}
  .hero-buttons{flex-wrap:wrap}
  .metrics{min-width:0}
  .industry-editorial article,.labour-cards article,.solution,.steps article,.workflow-grid article,
  .why-grid article,.benefit-grid article,.value-grid article,.work-area-grid a{min-width:0}
  .industry-editorial article,.labour-cards article{overflow:hidden}
  .contact-card{justify-self:stretch;min-width:0}
  .worker-form input[type=file]{font-size:11px;padding:9px 7px}
}

@media (max-width:520px){
  h1{font-size:clamp(34px,10.5vw,42px);line-height:1.08;letter-spacing:-1.2px}
  h2{font-size:clamp(28px,8.5vw,32px);letter-spacing:-.7px}
  .site-header{padding-left:8px;padding-right:8px}
  .header-inner{padding:0 10px;gap:8px}
  .brand{gap:8px}
  .brand span:not(.brand-mark){font-size:16px;line-height:17px}
  .brand small{font-size:9px;line-height:12px}
  .hero,.page-hero,.about-hero,.industry-hero,.worker-hero{padding-left:16px;padding-right:16px}
  .section{padding-left:16px;padding-right:16px}
  .hero-buttons{flex-direction:column;align-items:stretch;gap:10px}
  .hero-buttons .btn{width:100%}
  .metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;padding:12px}
  .metrics b{font-size:20px}
  .metrics span{font-size:9px;line-height:13px}
  .trust{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));overflow:visible;padding:14px 12px;gap:8px}
  .trust span{width:auto;min-width:0;justify-content:flex-start;font-size:11px}
  .trust span:last-child{grid-column:1/-1;justify-self:center}
  .about-photo,.industry-hero>img,.worker-hero>img,.page-hero>img{height:280px}
  .about-cta,.simple-cta,.split-cta{margin-left:16px;margin-right:16px}
  .about-cta,.simple-cta{padding-left:20px;padding-right:20px}
  .compliance{padding-left:16px;padding-right:16px}
  .compliance span{flex-basis:calc(50% - 8px);font-size:10px}
  .footer-grid{grid-template-columns:1fr;gap:24px}
  footer{padding-left:16px;padding-right:16px}
  .footer-bottom{overflow-wrap:anywhere}
  .contact-hero{padding-left:16px;padding-right:16px}
  .contact-hero h1{font-size:clamp(38px,12vw,52px)}
  .contact-main{padding-left:16px;padding-right:16px}
  .registration{margin-left:16px;margin-right:16px;padding-left:16px;padding-right:16px}
  .quick-path{margin-left:16px;margin-right:16px}
}

@media (max-width:360px){
  .brand span:not(.brand-mark){font-size:14px}
  .brand small{font-size:8px}
  .header-inner{padding-left:8px;padding-right:8px}
  .trust{grid-template-columns:1fr}
  .trust span:last-child{grid-column:auto;justify-self:stretch}
  .metrics{grid-template-columns:1fr}
  .metrics div{display:flex;align-items:baseline;justify-content:space-between;gap:8px}
  .metrics span{font-size:10px}
  .compliance span{flex-basis:100%}
}

/* ==========================================================================
   Hero Section - Pixel-Perfect Alignment with Reference Mockup
   ========================================================================== */
:root{--paper:#fff}
html,body{overflow-x:hidden}
.home-hero{
  position: relative;
  max-width: none;
  margin: 0 auto;
  min-height: 100vh;
  padding: 135px max(36px, calc((100vw - 1500px) / 2)) 0;
  display: grid;
  grid-template-columns: minmax(540px, 0.9fr) 1.1fr;
  column-gap: 32px;
  align-items: center;
  overflow: visible;
  background: 
    linear-gradient(180deg, #ffffff 0%, #fffefd 52%, #fff5e9 100%),
    radial-gradient(ellipse 65% 50% at 82% 14%, rgba(220, 205, 238, 0.45) 0%, transparent 65%),
    radial-gradient(ellipse 55% 45% at 94% 78%, rgba(254, 185, 120, 0.38) 0%, transparent 60%),
    radial-gradient(ellipse 50% 35% at 45% 15%, rgba(254, 220, 180, 0.3) 0%, transparent 55%),
    radial-gradient(ellipse 40% 40% at 8% 80%, rgba(254, 235, 215, 0.25) 0%, transparent 55%),
    #ffffff;
}

/* Left Column Content */
.home-hero .hero-copy{
  position: relative;
  z-index: 2;
  max-width: 700px;
}

/* Pill Eyebrow */
.hero-eyebrow-pill{
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  border-radius: 999px;
  background: #ffffff;
  border: 1px solid rgba(226, 232, 240, 0.85);
  box-shadow: 0 2px 10px rgba(15, 29, 56, 0.04);
  margin-bottom: 22px;
}
.eyebrow-beacon{
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: rgba(249, 115, 22, 0.2);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.eyebrow-beacon-core{
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #f97316;
}
.hero-eyebrow-pill b{
  font-size: 11px;
  font-weight: 700;
  color: #1e293b;
  letter-spacing: 0.5px;
}
.eyebrow-sep{
  color: #cbd5e1;
  font-weight: 300;
  font-size: 12px;
}
.hero-eyebrow-pill span{
  font-size: 11px;
  font-weight: 500;
  color: #64748b;
}

/* Headline */
.hero-heading{
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: clamp(52px, 3.6vw, 68px);
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -1.6px;
  color: #0f1d38;
  margin: 0 0 20px;
}
.hero-heading .orange-text{
  color: #ff7714;
  font-weight: 800;
  display: inline-block;
}

/* Subtitle */
.hero-subtext{
  font-size: 15px;
  line-height: 1.6;
  color: #4b5563;
  max-width: 480px;
  margin: 0 0 28px;
}

/* Button Row */
.hero-btn-row{
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 30px;
}
.btn-find-work{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  height: 48px;
  padding: 0 24px;
  border-radius: 12px;
  background: #ff7714;
  color: #ffffff;
  font-weight: 700;
  font-size: 14px;
  border: none;
  box-shadow: 0 8px 20px rgba(255, 119, 20, 0.35);
  cursor: pointer;
  text-decoration: none;
}
.btn-find-work:hover{
  background: #ea580c;
}
.btn-register-details{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  height: 48px;
  padding: 0 22px;
  border-radius: 12px;
  background: #ffffff;
  color: #0f1d38;
  font-weight: 700;
  font-size: 14px;
  border: 1px solid rgba(226, 232, 240, 0.9);
  box-shadow: 0 4px 14px rgba(15, 29, 56, 0.05);
  cursor: pointer;
  text-decoration: none;
}
.btn-register-details:hover{
  background: #f8fafc;
  border-color: #cbd5e1;
}

/* Social Proof Row */
.hero-social-row{
  display: flex;
  align-items: center;
  gap: 14px;
}
.avatar-stack{
  display: flex;
  align-items: center;
}
.avatar-img{
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 2.5px solid #ffffff;
  margin-left: -8px;
  box-shadow: 0 2px 6px rgba(15, 29, 56, 0.08);
  object-fit: cover;
  background: #f1f5f9;
}
.avatar-img.av1{
  margin-left: 0;
}
.avatar-pill-count{
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 2.5px solid #ffffff;
  margin-left: -8px;
  background: #f1f5f9;
  color: #1e293b;
  font-weight: 700;
  font-size: 11px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 6px rgba(15, 29, 56, 0.08);
  font-family: 'Plus Jakarta Sans', sans-serif;
}
.social-text{
  display: flex;
  flex-direction: column;
  font-size: 12px;
  line-height: 16px;
  color: #4b5563;
  font-weight: 500;
}

/* Right Visual Container */
.hero-visual-container{
  position: relative;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.hero-main-visual{
  display: block;
  width: 100%;
  max-width: 776px;
  height: auto;
  object-fit: contain;
  filter: drop-shadow(0 16px 36px rgba(15, 29, 56, 0.06));
  object-position: bottom center;
}

/* Bottom 3-Column Features Panel */
.hero-features-panel{
  grid-column: 1 / -1;
  width: 100%;
  display: grid;
  grid-template-columns: 1fr auto 1fr auto 1fr;
  align-items: center;
  background: #ffffff;
  border: 1px solid rgba(226, 232, 240, 0.85);
  border-radius: 20px;
  padding: 24px 36px;
  margin-top: -24px;
  box-shadow: 0 12px 35px rgba(15, 29, 56, 0.05);
  position: relative;
  z-index: 5;
}
.feature-col{
  display: flex;
  align-items: flex-start;
  gap: 16px;
}
.feature-icon-badge{
  width: 48px;
  height: 48px;
  border-radius: 12px;
  background: #fff5ed;
  border: 1px solid rgba(234, 88, 12, 0.2);
  color: #ea580c;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.feature-info{
  display: flex;
  flex-direction: column;
}
.feature-title{
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: 18px;
  font-weight: 800;
  color: #0f1d38;
  line-height: 1.2;
}
.feature-sub{
  font-size: 11px;
  font-weight: 700;
  color: #ea580c;
  letter-spacing: 0.6px;
  margin-top: 3px;
  text-transform: uppercase;
}
.feature-desc{
  font-size: 13px;
  line-height: 18px;
  color: #64748b;
  margin: 4px 0 0;
}
.feature-sep{
  width: 1px;
  height: 52px;
  background: #f1f5f9;
  margin: 0 20px;
}

/* Responsive Rules */
@media(max-width:1100px){
  .home-hero{padding: 120px 24px 36px; grid-template-columns: 1fr 1fr; gap: 24px;}
  .hero-heading{font-size: 42px;}
  .hero-features-panel{padding: 20px 24px;}
  .feature-sep{margin: 0 12px;}
}
@media(max-width:860px){
  .home-hero{grid-template-columns: 1fr; gap: 36px; padding: 110px 20px 40px;}
  .home-hero .hero-copy{max-width: 100%;}
  .hero-visual-container{max-width: 580px; margin: 0 auto;}
  .hero-features-panel{grid-template-columns: 1fr; gap: 20px; padding: 20px 18px; margin-top: 20px;}
  .feature-sep{display: none;}
}
.home-hero + .solutions{padding-top:24px}

/* Final polish: let the supplied artwork merge into the hero background instead
   of exposing the raster asset's rectangular edge. The artwork stays the same;
   only its transparent-looking perimeter and desktop gutter are adjusted. */
@media(min-width:861px){
  .hero-visual-container{
    width: calc(100% + 18px);
    margin-right: -18px;
  }

}

.hero-main-visual{
  -webkit-mask-image:
    linear-gradient(to right, transparent 0%, #000 5%, #000 91%, transparent 100%),
    linear-gradient(to bottom, transparent 0%, #000 5%, #000 93%, transparent 100%);
  -webkit-mask-composite: source-in;
  mask-image:
    linear-gradient(to right, transparent 0%, #000 5%, #000 91%, transparent 100%),
    linear-gradient(to bottom, transparent 0%, #000 5%, #000 93%, transparent 100%);
  mask-composite: intersect;
  position: relative;
  z-index: 1;
}

@media(max-width:860px){
  .hero-main-visual{
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 4%, #000 95%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 4%, #000 95%, transparent 100%);
  }
}

/* DOM-built hero artwork. The reference visual is recreated from independent
   layers so the worker, cards, orbit and atmosphere remain real UI elements. */
.hero-visual-art{
  position:relative;
  width:100%;
  min-height:544px;
  overflow:hidden;
  isolation:isolate;
}
.hero-glow,.hero-orange-blob,.hero-peach-blob,.hero-dots,.hero-orbit{position:absolute;display:block;pointer-events:none}
.hero-glow-warm{inset:10% 3% 4% 8%;background:radial-gradient(ellipse at 55% 46%,rgba(255,181,93,.42),rgba(255,210,169,.2) 46%,transparent 73%);filter:blur(20px);z-index:0}
.hero-glow-lilac{display:none}
.hero-orange-blob{width:66%;height:60%;left:17%;top:20%;border-radius:50%;background:linear-gradient(145deg,#ffb64f 5%,#ff7a1a 62%,#ffb38e 100%);transform:rotate(-7deg);z-index:1;opacity:.94}
.hero-peach-blob{width:58%;height:46%;left:28%;bottom:4%;border-radius:48%;background:radial-gradient(ellipse,#ffbd83 0%,rgba(255,169,128,.56) 46%,transparent 74%);filter:blur(18px);z-index:1;opacity:.84}
.hero-dots{inset:0;width:auto;height:auto;opacity:.26;background-image:radial-gradient(#ff7a1a 1.2px,transparent 1.2px);background-size:20px 20px;mask-image:linear-gradient(to bottom,#000 0%,rgba(0,0,0,.88) 42%,rgba(0,0,0,.3) 78%,transparent 100%);-webkit-mask-image:linear-gradient(to bottom,#000 0%,rgba(0,0,0,.88) 42%,rgba(0,0,0,.3) 78%,transparent 100%);z-index:0}
.hero-dots-right{display:none}
.hero-orbit{position:absolute;inset:0;width:100%;height:100%;border:0;border-radius:0;transform:none;overflow:visible;pointer-events:none}
.hero-orbit-back{z-index:2}
.hero-orbit-front{z-index:5}
.hero-orbit path{fill:none;stroke:#ff7a1a;stroke-width:3.2;stroke-linecap:round}
.hero-worker-image{position:absolute;z-index:4;width:min(100%,760px);height:auto;left:0%;bottom:-2px;object-fit:contain;filter:drop-shadow(0 20px 22px rgba(20,33,61,.12))}
.hero-float-card{position:absolute;z-index:6;display:flex;align-items:center;gap:13px;padding:14px 18px;border-radius:17px;box-shadow:0 13px 30px rgba(20,33,61,.12);font-family:'Plus Jakarta Sans',sans-serif}
.hero-card-icon{display:grid;place-items:center;width:44px;height:44px;border-radius:13px;flex:0 0 44px;background:#fff2e5;color:#ff7a1a}
.hero-float-card b{display:block;color:#14213d;font-size:16px;line-height:1.12;font-weight:800}
.hero-float-card small{display:block;margin-top:4px;color:#64748b;font-size:11px;line-height:1.3;font-weight:600;white-space:nowrap}
.hero-skilled-card{left:3%;top:28%;background:#fff}
.hero-placed-card{right:11%;top:39%;background:#173866;color:white}
.hero-placed-card b,.hero-placed-card small{color:#fff}.hero-placed-card .hero-card-icon{background:rgba(255,160,56,.28);color:#ff9a28}
.hero-safety-card{right:13%;bottom:17%;background:#fff}
.hero-community-note{position:absolute;z-index:6;right:12%;top:8%;color:#173866;font-family:cursive;font-size:19px;line-height:1.02;transform:rotate(-9deg);text-align:center}
.hero-community-note span{display:block;color:#ff7a1a;font:38px/1 Arial;margin-top:9px;transform:rotate(-22deg)}
.hero-features-panel{border:0}

@media(max-width:1100px) and (min-width:861px){
  .hero-visual-art{min-height:440px}.hero-float-card{transform:scale(.88);transform-origin:center}.hero-community-note{transform:scale(.85) rotate(-9deg)}
}
@media(max-width:860px){
  .hero-visual-art{min-height:430px}.hero-worker-image{width:78%;left:12%}.hero-orange-blob{left:13%;width:68%;height:72%}.hero-orbit{width:88%;left:3%}.hero-skilled-card{left:0;top:24%}.hero-placed-card{right:0;top:38%}.hero-safety-card{right:3%;bottom:12%}.hero-community-note{right:5%;top:5%;font-size:16px}.hero-float-card{padding:11px 13px;gap:8px}.hero-card-icon{width:38px;height:38px;flex-basis:38px}.hero-float-card b{font-size:13px}.hero-float-card small{font-size:9px}
}
@media(max-width:520px){
  .hero-visual-art{min-height:390px}.hero-skilled-card{left:-8%;top:25%}.hero-placed-card{right:-8%;top:39%}.hero-safety-card{right:-4%;bottom:10%}.hero-community-note{right:2%;font-size:14px}.hero-worker-image{width:86%;left:7%}.hero-dots{left:0}
}

/* Tablet layout safety: keep the existing visual system, but stack only the
   layouts that cannot fit comfortably between phone and desktop widths. */
@media (max-width:860px) and (min-width:521px){
  .site-header{padding-left:16px;padding-right:16px}
  .header-inner{height:68px;padding:0 16px}
  .site-header nav{display:none;position:absolute;top:76px;left:16px;right:16px;background:#fff;padding:12px;border-radius:12px;box-shadow:0 10px 30px rgba(15,29,56,.15);flex-direction:column;align-items:stretch}
  .site-header nav.open{display:flex}
  .site-header nav a{text-align:left;padding:10px 12px}
  .header-actions{margin-left:auto}
  .header-actions .phone,.header-actions .btn{display:none}
  .menu-btn{display:grid;place-items:center}
  .home-hero{min-height:auto;padding:110px 28px 48px}
  .hero-features-panel{margin-top:16px}
  .about-hero,.industry-hero,.worker-hero{grid-template-columns:1fr;padding:112px 32px 56px;gap:28px}
  .about-photo,.industry-hero>img,.worker-hero>img{height:360px}
  .page-hero{grid-template-columns:1fr;padding:128px 32px 64px;min-height:auto}
  .page-hero>img{height:360px}
  .section{padding:64px 32px}
  .section-heading{display:block}
  .section-heading>p{margin-top:16px}
  .solution-grid,.industries,.steps,.workflow-grid,.employer-tiles,.why-grid,
  .request-section,.split-cta,.quick-path,.contact-main,.registration,
  .flexible-band,.industry-editorial,.labour-cards{grid-template-columns:1fr}
  .industry-editorial article{grid-template-columns:1fr;direction:ltr}
  .industry-editorial article.reverse>div{direction:ltr}
  .industry-editorial img{height:280px;min-height:280px}
  .labour-cards article,.labour-cards article:nth-child(even){grid-template-columns:1fr;direction:ltr}
  .labour-cards article:nth-child(even)>div{direction:ltr}
  .labour-cards img{height:280px;grid-row:1}
  .workflow-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .benefit-grid,.worker-benefits .benefit-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .timeline-row{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}
  .timeline-row:before{top:20px;left:12%;right:12%}
  .contact-main{padding:64px 32px;gap:32px}
  .registration{margin-left:32px;margin-right:32px;padding:32px;gap:32px}
  .quick-path{margin-left:32px;margin-right:32px}
  footer{padding-left:32px;padding-right:32px}
}

@media (max-width:520px){
  .home-hero{min-height:auto}
  .brand span:not(.brand-mark){display:flex;flex-direction:column}
  .brand span:not(.brand-mark) b{font-size:16px;line-height:17px}
  .brand small{font-size:8px;line-height:11px}
  .hero-features-panel{grid-template-columns:1fr;padding:16px}
  .feature-col{gap:10px}
  .feature-title{font-size:16px}
  .feature-desc{font-size:12px}
  .hero-visual-art{min-height:400px}
  .hero-worker-image{width:82%;left:9%}
  .hero-skilled-card{left:0;top:24%}
  .hero-safety-card{right:0;bottom:8%}
}

/* Keep long-form content aligned consistently across every viewport. */
p{ text-align:justify; text-justify:inter-word; }

@media (max-width:520px){
  .hero-visual-art{min-height:410px}
  .hero-worker-image{width:108%;left:-4%}
  .hero-skilled-card{top:23%}
  .hero-safety-card{bottom:7%}
}

/* Compact mobile hero composition: prevent heading overflow and keep the
   artwork/cards balanced inside the phone viewport. */
@media (max-width:520px){
  .home-hero .hero-heading{
    font-size:clamp(30px,8.8vw,34px);
    line-height:1.08;
    letter-spacing:-1px;
  }
  .home-hero .hero-heading .orange-text{
    display:block;
    font-size:inherit;
    white-space:normal;
  }
  .home-hero .hero-subtext{
    font-size:14px;
    line-height:22px;
  }
  .home-hero .hero-btn-row{gap:8px}
  .home-hero .btn-find-work,
  .home-hero .btn-register-details{
    min-width:0;
    padding-left:12px;
    padding-right:12px;
    font-size:12px;
  }
  .hero-visual-art{min-height:360px;margin-top:4px}
  .hero-orange-blob{width:60%;height:78%;left:20%;top:8%}
  .hero-worker-image{width:102%;left:-1%}
  .hero-float-card{padding:10px 12px;border-radius:14px;gap:8px}
  .hero-card-icon{width:34px;height:34px;flex-basis:34px;border-radius:10px}
  .hero-float-card b{font-size:12px}
  .hero-float-card small{font-size:8px}
  .hero-skilled-card{left:3%;top:17%}
  .hero-safety-card{right:3%;bottom:6%}
}
