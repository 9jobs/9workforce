SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@9workforce.com.au
SMTP_PASS=replace-with-your-app-password
MAIL_TO=support@9workforce.com.au
API_PORT=4000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-secret-key

# Google OAuth: local and production use the same callback path.
# Local: http://localhost:3001/api/auth/callback/google
# Production: https://9workforce.com.au/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: otherwise a persistent random secret is generated in ignored data/.
BETTER_AUTH_SECRET=

# Vercel production: use a stable random secret (at least 32 characters).
BETTER_AUTH_URL=https://9workforce.com.au
# Explicit HTTPS origins only. Leave empty if only the canonical domain is used.
BETTER_AUTH_TRUSTED_ORIGINS=
# Supabase -> Connect -> Transaction pooler. Include the real, URL-encoded password.
DATABASE_URL=
# Optional, protects /api/account/delivery for retrying pending notifications.
CRON_SECRET=
